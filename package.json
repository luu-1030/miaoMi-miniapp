{
  "name": "miaomi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run sync:game && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run sync:game && node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "node scripts/smoke.mjs",
    "sync:game": "node scripts/sync-game.mjs",
    "check:game": "node scripts/sync-game.mjs --check",
    "check:miniapp": "npm run check:game && node scripts/check-miniapp.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  }
}
