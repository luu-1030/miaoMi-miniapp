-head{background:linear-gradient(120deg,#645c55 0 26%,#f2e4cd 26% 62%,#dfa163 62%)!important}.tuxedo .chest,.tuxedo .paw{background:#faf1de}.tuxedo .muzzle{height:39px;top:42px;border-radius:50% 50% 40% 40%}.tuxedo .eye{background:#ebd592}.bowl{position:absolute;right:22px;bottom:39px;width:39px;height:22px;background:#b3beac;border-radius:4px 4px 15px 15px;border-top:5px solid #8f9f84}.bowl-mark{display:block;font-size:9px;color:#f4f1df;text-align:center}.tap-note{position:absolute;bottom:12px;left:0;width:100%;text-align:center;color:#a39579;font-size:10px}.ribbon{position:absolute;left:81px;top:110px;z-index:4;display:flex;align-items:center}.ribbon-left,.ribbon-right{width:17px;height:20px;background:#bd7d81;border-radius:4px 10px 10px 4px}.ribbon-right{transform:rotate(180deg)}.ribbon-center{position:absolute;left:13px;width:8px;height:10px;background:#d6a1a1;border-radius:4px}.scarf{position:absolute;left:63px;top:106px;width:75px;height:13px;background:#98b6a7;border-radius:7px;z-index:4}.scarf-end{position:absolute;top:9px;left:10px;width:16px;height:28px;background:#8ba99a;border-radius:0 0 4px 4px}.sleep-mark{position:absolute;right:0;top:17px;color:#a49782;font-size:17px;letter-spacing:5px}.sleepy .eye{height:3px;top:47px;border-radius:5px}.curious .cat-head{transform:rotate(-8deg)}.shy{transform:translateX(-50%) scale(.92)}.shy .cat-head{top:30px}.proud .cat-head{transform:rotate(8deg)}.proud .face{transform:translateX(8px)}.clingy .cat-head{animation:head-bob 4s ease-in-out infinite}.away{opacity:.18}.room-away .tail{animation:none}@keyframes tail-sway{0%,100%{transform:rotate(-28deg)}50%{transform:rotate(-5deg)}}@keyframes head-bob{0%,100%{transform:rotate(0)}50%{transform:rotate(-5deg)}}@media(prefers-reduced-motion:reduce){.tail,.clingy .cat-head{animation:none}}
</style>
