<template>
  <view class="room" :class="roomClass">
    <view class="window"><view class="window-cross horizontal"/><view class="window-cross vertical"/><view class="sun"/><view class="cloud"/></view>
    <text class="room-note">{{ away ? '把熟悉的小毯子带上吧' : '阳光、呼噜声，还有你' }}</text>
    <view class="plant"><view class="leaf leaf-one"/><view class="leaf leaf-two"/><view class="plant-pot"/></view>
    <view class="floor"/>
    <view class="rug"/>
    <button class="cat-button" :class="[breed, pose, away ? 'away' : '']" :aria-label="away ? '小咪出门了' : '摸摸小咪'" :disabled="away" @click="emit('pet')">
      <view class="tail" :style="{ backgroundColor: coat }"/>
      <view class="cat-body" :style="{ backgroundColor: coat }"><view class="chest"/><view class="paw left-paw"/><view class="paw right-paw"/></view>
      <view class="cat-head" :style="{ backgroundColor: coat }">
        <view class="ear left-ear" :style="{ backgroundColor: coat }"><view class="ear-inner"/></view>
        <view class="ear right-ear" :style="{ backgroundColor: coat }"><view class="ear-inner"/></view>
        <view class="stripe stripe-one"/><view class="stripe stripe-two"/><view class="stripe stripe-three"/>
        <view class="face"><view class="eye left-eye"/><view class="eye right-eye"/><view class="muzzle"/><view class="nose"/><view class="mouth"/><view class="cheek left-cheek"/><view class="cheek right-cheek"/></view>
      </view>
      <view v-if="outfit == 'ribbon'" class="ribbon"><view class="ribbon-left"/><view class="ribbon-right"/><view class="ribbon-center"/></view>
      <view v-if="outfit == 'scarf'" class="scarf"><view class="scarf-end"/></view>
      <text v-if="pose == 'sleepy' && !away" class="sleep-mark">z z Z</text>
    </button>
    <view class="bowl"><text class="bowl-mark">♥</text></view>
    <text class="tap-note">{{ away ? '门口的小脚印，还等着你' : '轻轻点一下，摸摸它' }}</text>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
const props = defineProps({
  breed: { type: String, default: 'orange' },
  pose: { type: String, default: 'calm' },
  outfit: { type: String, default: '' },
  away: { type: Boolean, default: false },
})
const emit = defineEmits(['pet'])
const coat = computed(() => ({ orange: '#e4a363', ragdoll: '#e8d8c3', british: '#97a7b2', calico: '#e7ba8a', tuxedo: '#62686a' }[props.breed] || '#e4a363'))
const roomClass = computed(() => props.away ? 'room-away' : '')
</script>

<style scoped>
.room{position:relative;height:295px;background:#f5eddc;border-radius:22px;overflow:hidden;isolation:isolate}.window{position:absolute;right:25px;top:25px;width:105px;height:112px;background:#e2ebdf;border:7px solid #fffaf0;border-radius:50px 50px 4px 4px;overflow:hidden}.window-cross{position:absolute;background:#fffaf0;z-index:2}.horizontal{width:100%;height:5px;top:55%}.vertical{height:100%;width:5px;left:48%}.sun{position:absolute;top:15px;right:15px;width:29px;height:29px;border-radius:50%;background:#f2dca5}.cloud{position:absolute;bottom:15px;left:8px;width:52px;height:20px;border-radius:30px;background:#f7f8ed}.room-note{position:absolute;left:20px;top:25px;color:#a39778;font-size:11px;letter-spacing:1px;width:105px;line-height:20px}.floor{position:absolute;bottom:0;width:100%;height:100px;background:#eae0ca;border-top:3px solid #d9ccb0}.rug{position:absolute;left:14%;bottom:28px;width:72%;height:70px;border:4px solid #d4c7ab;border-radius:50%;background:#ddd2b6}.plant{position:absolute;left:24px;bottom:82px;width:48px;height:72px}.plant-pot{position:absolute;bottom:0;left:8px;width:34px;height:30px;background:#c6a181;border-radius:3px 3px 12px 12px}.leaf{position:absolute;width:18px;height:42px;background:#9daa82;border-radius:80% 10% 80% 10%;bottom:22px}.leaf-one{left:10px;transform:rotate(-32deg)}.leaf-two{left:26px;transform:rotate(22deg)}.cat-button{position:absolute;left:50%;bottom:36px;transform:translateX(-50%);width:190px;height:180px;overflow:visible;margin:0;padding:0;background:transparent;border:0;line-height:normal}.cat-button::after{border:0}.cat-body{position:absolute;left:53px;bottom:8px;width:92px;height:94px;border-radius:45% 45% 32% 32%;z-index:2}.chest{position:absolute;left:25px;top:23px;width:48px;height:60px;background:#f1d3a5;border-radius:50%;opacity:.8}.cat-head{position:absolute;left:40px;top:23px;width:110px;height:91px;border-radius:44% 44% 46% 46%;z-index:3}.ear{position:absolute;top:-16px;width:37px;height:49px;border-radius:8